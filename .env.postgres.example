DB_TYPE=POSTGRES
DB_SERVER=protheus_postgres
DB_PORT=5432

# --- DBACCESS AUTOMATION TARGETS (Acesso da Aplicação) ------------------------
# Default padronizado (2026-09-16): mesmo usuário/senha/banco no compose e no
# cluster k8s. Só mude se você (dev) realmente precisar de outro valor --
# senha sem ';'/'='/aspas (vai sem escaping para dbaccess.ini via sed no
# entrypoint do dbaccess, que usa ';' como separador da ConnectionString).
DB_USER=protheus
DB_PASS=ProtheusPwd2026
DB_NAME=protheus

# --- POSTGRES ENGINE CONFIGURATION (ROOT SUPERUSER) ---------------------------
POSTGRES_ROOT_USER=postgres
POSTGRES_ROOT_PASSWORD=root_postgres_secure_password
POSTGRES_PORT=5432