# Variáveis Globais de Ambiente
# Default padronizado (2026-09-16): mesmo nome de ambiente no compose e no
# cluster k8s. Só mude se você (dev) realmente precisar de um ambiente
# diferente do padrão.
ENV_NAME=protheus

# IP onde TODAS as portas deste Compose são publicadas no host (ver docker-compose.yaml).
# Default 127.0.0.2 desde o ADR 0017 (repo k8s-protheus-devops-stack): o cluster k3d tem
# prioridade sobre as portas padrão do Protheus em 127.0.0.1, então este Compose usa um
# IP de loopback separado para rodar junto sem colidir.
HOST_BIND_IP=127.0.0.2

# Governança de Infraestrutura (Novas Variáveis)
DBACCESS_PORT=7890
# Porta do host onde o dbaccess é publicado (lado esquerdo do mapeamento). Voltou ao
# padrão 7890 em 2026-10-04 -- a colisão com a 7890 do serverlb do k3d (motivo de ter
# ido pra 7891 em 2026-09-18) não existe mais, porque agora as duas stacks publicam em
# IPs de loopback diferentes (ver HOST_BIND_IP acima).
DBACCESS_HOST_PORT=7890
DBACCESS_SERVER=protheus_dbaccess
LICENSE_SERVER=protheus_license
LICENSE_SERVER_PORT=5555

# Configurações de Portas Multiprotocolo (TCP/WebApp)
CORE_PORT_MULTI=1234
REST_PORT_MULTI=1235
TELNET_PORT_MULTI=1236

# Portas Especialistas de Serviços Dedicados
APP_MONITOR_PORT=32033
TELNET_PORT=23

# Parametrização Dedicada do Barramento REST API
REST_HTTP_PORT=8400
REST_URI=/rest
REST_PREP_ENV=99,01
REST_INSTANCES=1,1